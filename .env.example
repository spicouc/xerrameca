XERRAMECA_HOST=0.0.0.0
XERRAMECA_PORT=8791
XERRAMECA_DB_PATH=/var/lib/xerrameca/xerrameca.db
XERRAMECA_IDENTITY_PROVIDER=pluribus
PLURIBUS_BASE_URL=http://127.0.0.1:8790
PLURIBUS_TIMEOUT_SECONDS=10
# Optional service/integration agent credential for deliberate Brain summary writes.
# PLURIBUS_SERVICE_API_KEY=configure-at-runtime-only
# Secrets are never committed. Configure runtime credentials outside Git.
