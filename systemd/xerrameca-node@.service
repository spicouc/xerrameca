[Unit]
Description=Xerrameca federated node (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xerrameca
Group=xerrameca
WorkingDirectory=/opt/xerrameca
ExecStart=/opt/xerrameca/venv/bin/xerrameca node --state-dir /var/lib/xerrameca/%i --host 0.0.0.0 --port 8791
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/xerrameca/%i
UMask=0077

[Install]
WantedBy=multi-user.target
